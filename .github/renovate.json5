{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // docker:pinDigests: ベースイメージ（ruby:X-slim）を digest で固定する。タグのままだと Ruby・Debian の
  // 更新がリリース時のビルドで無言で入る。固定すると digest の更新が PR になり、CI（smoke）でビルドと起動を
  // 通してから取り込める。
  extends: ['config:recommended', 'docker:pinDigests'],
  timezone: 'Asia/Tokyo',
  // 週2回にまとめる（毎日 PR が来ると確認が追いつかず、週1だと間隔が空きすぎる）。
  schedule: ['before 9am on monday and thursday'],
  // 時間あたりの上限（既定は1時間に2件）は外す。数は schedule で既に絞っており、App は枠の中で
  // 数回しか動かないため、1回の枠で作られる PR が少なく、溜まった更新が次の枠へ持ち越される。
  // 同時に開く数の上限（prConcurrentLimit・既定10）は、CI が壊れたときに PR が溜まり続けないよう残す。
  prHourlyLimit: 0,
  // GitHub Release のノートで Dependencies の見出しに分ける（.github/release.yml）。
  labels: ['dependencies'],
  // PR を github.com/pulls の「Assigned to you」にまとめる（いくつものリポジトリから来るので見落とさない）。
  // （自動マージにする PR は既定で assign されず、自動マージに失敗したときだけ assign される）
  assignees: ['highemerly'],
  // 間接依存（Gemfile.lock だけにある版。nokogiri・rack・ethon など）を週1で `bundle lock --update` する。
  // 直接依存の PR では、その gem が要求する分しか上がらないため。
  lockFileMaintenance: {
    enabled: true,
  },
  // メジャーはコード側の対応が要ることが多いので、着手するときに Dependency Dashboard で承認して PR を作らせる
  // （自動で並ぶと、対応できないまま毎週 rebase される PR が溜まる）。
  major: {
    dependencyDashboardApproval: true,
  },
  packageRules: [
    {
      // 乗っ取られて公開された版は数日以内に取り下げられることが多いため、公開から3日待つ。
      // rubygems に限る（Docker の digest には公開日時が無く、待てないため）。
      matchDatasources: ['rubygems'],
      minimumReleaseAge: '3 days',
    },
    {
      // Ruby の版は .ruby-version（CI の setup-ruby もここを読む）・Gemfile の ruby・Dockerfile の
      // ruby:X-slim を揃えて上げる必要があるため1つの PR にまとめる。
      matchDepNames: ['ruby'],
      groupName: 'Ruby',
    },
    {
      // Ruby の 4.0 → 4.1 は Renovate ではマイナーだが、年1回の互換性を崩しうる更新（標準ライブラリの
      // 切り出しなど）。ネイティブ拡張の gem の対応を待つこともあるので、メジャーと同じく承認制にする。
      matchDepNames: ['ruby'],
      matchUpdateTypes: ['minor'],
      dependencyDashboardApproval: true,
    },
    {
      // Rails の 8.1 → 8.2 も Renovate ではマイナーだが、非推奨の機能が消え、設定の追従
      // （`rails app:update`・load_defaults）が要る。メジャーと同じく承認制にする。
      matchPackageNames: ['rails'],
      matchUpdateTypes: ['minor'],
      dependencyDashboardApproval: true,
    },
    {
      // マイナー・パッチ・digest は CI（ci-result＝minitest・bundler-audit・本番イメージの smoke）が緑なら自動でマージする。
      // smoke は本番と同じイメージで Puma を起動し、db:prepare を通し、handon.club から本物の nodeinfo を取るところまで見る
      // （typhoeus・ethon は minitest ではスタブだが、smoke と live_nodeinfo_test で本物の libcurl を通る）。
      // digest（ruby:X-slim）も、Dockerfile の変更で smoke がイメージをビルドして走るので自動にする。
      // メジャー（承認制）・lockfile の一括更新は手でマージする（lockfile は間接依存がまとめて動くため）。
      // マージしても main に入るだけで、本番へはリリース（タグ）とデプロイ PR のマージを経る。
      matchUpdateTypes: ['minor', 'patch', 'digest'],
      automerge: true,
    },
    {
      // Ruby・Rails のマイナーは上の承認制。承認して作らせた PR が minor の自動マージに拾われないようにする
      // （Renovate は承認制の PR にも通常の packageRules を当てる）。
      matchDepNames: ['ruby', 'rails'],
      matchUpdateTypes: ['minor'],
      automerge: false,
    },
    {
      // CI が緑でも確かめていないもの。1つの PR に1つでも automerge: false の更新があれば自動ではマージされない。
      // - graphql-client: 0.x。使っている fediverse.observer の取得は止めていて、テストも無い
      // - simpleidn: 0.x。マイナーでも互換を崩しうるのに Renovate はメジャー扱いしない
      // 0.x の依存を足したら、ここにも足す。
      matchPackageNames: ['graphql-client', 'simpleidn'],
      automerge: false,
    },
    {
      // タグ時にしか動かないワークフローは、ブランチの CI（ci-targets.sh）で何も回さず
      // ci-result がスキップのまま緑になる＝何も確かめずにマージされてしまう。
      matchFileNames: ['.github/workflows/docker-build.yml', '.github/workflows/tag-release.yml'],
      automerge: false,
    },
  ],
}
